meta {
  name: Predict scalar
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/predict
  body: json
  auth: none
}

body:json {
  {
    "text": "a good film with a warm ending"
  }
}

tests {
  test("one sentence returns one prediction", function() {
    expect(res.status).to.eql(200);
    expect(res.body.predictions).to.be.an("array").that.has.lengthOf(1);
    expect(res.body.predictions[0].label).to.be.a("string");
    expect(res.body.predictions[0].score).to.be.a("number");
    expect(res.body.predictions[0].score).to.be.at.least(0).and.at.most(1);
  });
}
