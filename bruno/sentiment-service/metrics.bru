meta {
  name: Metrics
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/metrics
  body: none
  auth: none
}

tests {
  test("Prometheus series for requests and rejections are exported", function() {
    expect(res.status).to.eql(200);
    expect(res.body).to.include("sentiment_requests_total");
    expect(res.body).to.include("sentiment_request_duration_seconds_bucket");
    expect(res.body).to.include("sentiment_rejections_total");
  });
}
