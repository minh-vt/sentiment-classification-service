# Copy to .env (git-ignored). This file drives `just` recipes and `docker compose`
# interpolation; the service itself only reads process environment variables and
# never parses .env.

# Where `just serve` finds the bundle on this machine. Inside the container the
# image provides /app/models/sentiment instead, so this value does not travel there.
MODEL_DIR=artifacts/sentiment

# Runtime policy for a host process (`just serve`). The container keeps the
# defaults baked into Settings; override there with `docker run -e`.
HOST=0.0.0.0
PORT=8000
MAX_BATCH_SIZE=32
MAX_POSITIONS=512
MAX_CONCURRENCY=4

# Deployment wiring for Compose. The container always listens on 8000, so only the
# published host port is configurable.
HOST_PORT=8000

# One image tag for `just build` and Compose; this does not publish the image.
SERVICE_IMAGE=sentiment-service:local
